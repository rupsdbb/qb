# qBittorrent-nox WebUI (same host is best; then enable "Bypass authentication for clients on localhost")
QB_URL=http://127.0.0.1:8080
QB_USER=admin
QB_PASS=change-me

# Where this app listens
LISTEN=0.0.0.0:8099

# Serve under a sub-path, e.g. /m when a reverse proxy forwards /m/ unchanged (no trailing slash)
#BASE_PATH=/m

# Password for this UI. Strongly recommended unless only reachable over a private network.
UI_PASSWORD=
